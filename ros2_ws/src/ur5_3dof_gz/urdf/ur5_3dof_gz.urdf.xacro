<?xml version="1.0"?>
<!--
  UR5 URDF for Gazebo Harmonic (gz_ros2_control).

  Joints 1-3 (shoulder_pan / shoulder_lift / elbow) are driven by an effort
  controller.  Joints 4-6 (wrist 1/2/3) are held at zero by a position
  controller.

  Initial pose: fully erect (arm pointing straight up).
    q0 = [0, -π/2, 0, 0, 0, 0]
  This matches the real UR5's vertical home position. From here the PID
  controller drives the arm to a side-reach "pickup" pose.
-->
<robot name="ur5_3dof_gz" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/>

  <!-- Fixed world anchor -->
  <link name="world"/>

  <!-- UR5 kinematic / visual / collision structure -->
  <xacro:ur_robot
      name="ur5"
      tf_prefix=""
      parent="world"
      joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml"
      safety_limits="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ros2_control hardware — Gazebo Harmonic system plugin -->
  <ros2_control name="ur5_gz_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Initial pose: arm pointing straight up at the ceiling -->
    <xacro:ur_joint_control_description
        tf_prefix=""
        initial_positions="${dict(
            shoulder_pan_joint=0.0,
            shoulder_lift_joint=-1.5707963267948966,
            elbow_joint=0.0,
            wrist_1_joint=0.0,
            wrist_2_joint=0.0,
            wrist_3_joint=0.0)}"/>
  </ros2_control>

  <!-- Gazebo Harmonic: load gz_ros2_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find ur5_3dof_gz)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
